{
  "name": "dsh-memory-steward",
  "version": "0.1.0",
  "description": "记忆管家：为 dsh-memory-evolve 补上记忆入库之后的生命周期闭环——预算看门狗、整理到期提醒、待审批队列与审批 Tab、带备份执行。只读观测记忆文件，写入一律回调 memory-evolve 官方 HTTP API。",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "skills",
    "scripts",
    "test",
    "docs",
    "cordis.patch.yml",
    "TESTING.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "memory-lifecycle",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezon-aki/dsh-memory-steward.git"
  },
  "homepage": "https://github.com/rezon-aki/dsh-memory-steward#readme",
  "bugs": {
    "url": "https://github.com/rezon-aki/dsh-memory-steward/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
